# Copia este archivo como .env y ajusta los valores, o define estas variables en tu servidor.
# (Node 20.6+ las lee con: node --env-file=.env backend/src/server.js)

# Conexión a PostgreSQL
DATABASE_URL=postgres://renty:renty@localhost:5432/renty
# Proveedores en la nube (Neon, Supabase, RDS, Render…) suelen exigir SSL
# DATABASE_SSL=true

# Base para `npm test` (se BORRA en cada corrida; su nombre debe contener "test")
# TEST_DATABASE_URL=postgres://renty:renty@localhost:5432/renty_test

PORT=3000
# NODE_ENV=production
# UPLOADS_DIR=backend/uploads
# SESION_DIAS=14
